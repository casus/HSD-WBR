{
    "results_dir": "examples/mobilesam/models/",
    "parameters": {
        "checkpoint_path": "weights/mobile_sam.pt",
        "epochs": 50,
        "lr": 0.0001,
        "use_gpu": true,
        "freeze_image_encoder": true,
        "train_wbr_loss": false,
        "wbr_loss_weight": 0.0,
        "wbr_eps": 0.001,
        "extension": ".tif",
        "seed": 11
    },
    "train": {
        "img_dir": "data/train/images/",
        "mask1_dir": "data/train/mask1/",
        "mask2_dir": "data/train/mask2/"
    },
    "validation": {
        "img_dir": "data/val/images/",
        "mask1_dir": "data/val/mask1/",
        "mask2_dir": "data/val/mask2/"
    },
    "test": {
        "img_dir": "data/test/images/",
        "mask1_dir": "data/test/mask1/",
        "mask2_dir": "data/test/mask2/"
    }
}

